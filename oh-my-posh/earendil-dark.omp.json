{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        { "foreground": "#e1ab4f", "style": "plain", "template": "\u279c", "type": "text" },
        { "foreground": "#e8e5de", "properties": { "style": "folder" }, "style": "plain", "template": " {{ .Path }} ", "type": "path" },
        { "foreground": "#efc272", "properties": { "branch_icon": "" }, "style": "plain", "template": "<#8e8779>git:(</>{{ .HEAD }}<#8e8779>)</>", "type": "git" },
        { "foreground": "#d9744f", "style": "plain", "template": " \u2717", "type": "status" }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 3
}
