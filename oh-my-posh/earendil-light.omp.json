{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#9a6e1e",
          "style": "plain",
          "template": "\u279c",
          "type": "text"
        },
        {
          "foreground": "#241c11",
          "properties": {
            "style": "folder"
          },
          "style": "plain",
          "template": " {{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "#7e5a1b",
          "properties": {
            "branch_icon": ""
          },
          "style": "plain",
          "template": "<#6b6558>git:(</>{{ .HEAD }}<#6b6558>)</>",
          "type": "git"
        },
        {
          "foreground": "#9a3b22",
          "style": "plain",
          "template": " \u2717",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 3
}
