# Earendil — paper & ink (dark)
#
# 纸墨色的深色版：暖炭墨底 + 纸白正文 + 琥珀强调。
# 与 pi 主题 earendil-dark 同源。
#
#   底 #1b1710   ·   正文 #e8e5de   ·   琥珀 #e1ab4f
#
# 用法：
#   theme = /path/to/theme/ghostty/earendil-dark
# 或复制到 ~/.config/ghostty/themes/ 后：
#   theme = earendil-dark
#
# 与浅色版的关键差异：深底上 bright 槽位比 normal 更亮；浅底正好相反
# （在纸上越亮越看不见，所以浅色版把 bright 取了更深的值）。
#
# 蓝/青槽位仍用低饱和暖灰占位，无蓝绿，保证 ls / git / 16 色 vim 仍可分辨。
# 每个槽位对底色 #1b1710 都留了余量：normal ≥4.5:1，dim 槽（0/8）≥2:1 / ≥3:1。

# ── 基础色 ────────────────────────────────────────────────────

background = 1b1710
foreground = e8e5de
cursor-color = e1ab4f
cursor-text = 1b1710
selection-background = 382e1b
selection-foreground = e8e5de
split-divider-color = 4a4234

# ── 16 色 ANSI ─────────────────────────────────────────────────

palette = 0=#554d3e
palette = 1=#c86a4a
