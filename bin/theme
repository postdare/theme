#!/usr/bin/env bash
# theme — 同步切换 Ghostty / pi / oh-my-posh 三层配色
#
#   theme status    显示三层当前状态
#   theme dark      全部切到暖墨深色
#   theme light     全部切到奶油纸色
#
# 存在的理由：终端底色、pi 主题、oh-my-posh prompt 各自独立保存颜色，手动切必漏
# 其中一层，而漏掉的那层在换底后会直接隐形。实测数据：
#
#   pi 墨色 #241c11 印在暖墨底 #1b1710 上  =  1.06:1   （整个 TUI 消失）
#   prompt 路径 #241c11 印在 #1b1710 上    =  1.06:1
#   prompt 路径 #e8e5de 印在奶油底 #e8e5de 上 = 1.00:1
#
# 每次改动前都会备份到 *.bak-theme。
#
# 只用 awk，不依赖 python3：全新的 Mac 上 /usr/bin/python3 只是个存根，一跑就弹
# Xcode CLT 安装框。
set -uo pipefail

# ── 定位仓库根：优先 $THEME_REPO，否则由脚本自身位置推导（脚本应在 <repo>/bin/）──
resolve_dir() {
  local p="$1" d
  while [ -L "$p" ]; do
    d="$(cd "$(dirname "$p")" && pwd)"
    p="$(readlink "$p")"
    case "$p" in /*) ;; *) p="$d/$p" ;; esac
  done
  cd "$(dirname "$p")" && pwd
}
SCRIPT_DIR="$(resolve_dir "${BASH_SOURCE[0]:-$0}")"
THEME_REPO="${THEME_REPO:-$(cd "$SCRIPT_DIR/.." && pwd)}"

# ── 各层路径（都可用环境变量覆盖）──
GHOSTTY_CFG="${GHOSTTY_CONFIG:-$HOME/.config/ghostty/config}"
PI_SETTINGS="${PI_SETTINGS:-$HOME/.pi/agent/settings.json}"
POSH_DIR="${POSH_DIR:-$HOME/.poshthemes}"
POSH_ACTIVE="$POSH_DIR/earendil.omp.json"

# Collapse $HOME to ~. Deliberately NOT `${1/#$HOME/~}`: bash 5 tilde-expands the
# replacement straight back into $HOME so nothing collapses, while escaping it as `\~`
# leaves a literal backslash on bash 3.2. Prefix matching behaves the same everywhere.
tilde() { # tilde <path>
  case "$1" in
    "$HOME")   printf '~';;
    "$HOME"/*) printf '~%s' "${1#"$HOME"}";;
    *)         printf '%s' "$1";;
  esac
}

warn() { printf '  ! %s\n' "$*" >&2; }
die()  { printf '✗ %s\n' "$*" >&2; exit 1; }

# ── Ghostty ──────────────────────────────────────────────────────────
# 整行替换 `key = value`，没有就追加。写临时文件再 mv，中途失败不会留下半个配置。
set_key() { # set_key <file> <key> <value>
  local f="$1" k="$2" v="$3" tmp="$1.theme.$$"
  awk -v k="$k" -v v="$v" '
    BEGIN { hit = 0 }
    !hit && $0 ~ "^[ \t]*" k "[ \t]*=" { print k " = " v; hit = 1; next }
    { print }
    END { if (!hit) print k " = " v }
  ' "$f" > "$tmp" || { rm -f "$tmp"; return 1; }
  mv "$tmp" "$f"
}

ghostty_write() {
  local theme_path="$1" window_theme="$2"
  [ -f "$GHOSTTY_CFG" ] || { warn "没有 ${GHOSTTY_CFG}，跳过 Ghostty"; return 1; }
  cp "$GHOSTTY_CFG" "$GHOSTTY_CFG.bak-theme"
  set_key "$GHOSTTY_CFG" theme "$theme_path" &&
    set_key "$GHOSTTY_CFG" window-theme "$window_theme"
}

ghostty_reload() {
  local pid
  # pgrep 在部分 macOS 环境下看不到 Ghostty 进程，退回 ps
  pid=$(ps -Ao pid,command | grep -F 'MacOS/ghostty' | grep -v grep | awk '{print $1}' | head -1)
  [ -n "$pid" ] && kill -USR2 "$pid" 2>/dev/null
}

# ── pi ───────────────────────────────────────────────────────────────
# settings.json 里只改一个顶层字符串键。改不动就报错退出，绝不猜 —— 写坏 settings.json
# 比报个错严重得多。
pi_write() {
  local tmp="$PI_SETTINGS.theme.$$"
  [ -f "$PI_SETTINGS" ] || { warn "没有 ${PI_SETTINGS}，跳过 pi"; return 1; }
  cp "$PI_SETTINGS" "$PI_SETTINGS.bak-theme"
  awk -v v="$1" '
    BEGIN { hit = 0 }
    !hit && /"theme"[ \t]*:/ {
      sub(/"theme"[ \t]*:[ \t]*"[^"]*"/, "\"theme\": \"" v "\"")
      hit = 1
    }
    { buf[NR] = $0 }
    END {
      for (i = 1; i <= NR; i++) {
        print buf[i]
        if (!hit && i == 1 && buf[i] ~ /^[ \t]*\{[ \t]*$/) {
          print "  \"theme\": \"" v "\","
          hit = 1
        }
      }
      if (!hit) exit 1
    }
  ' "$PI_SETTINGS" > "$tmp" || { rm -f "$tmp"; warn "改不动 ${PI_SETTINGS}，跳过 pi"; return 1; }
  mv "$tmp" "$PI_SETTINGS"
}

# ── oh-my-posh ───────────────────────────────────────────────────────
# 配置由本仓库提供（oh-my-posh/earendil-*.omp.json）。拷到固定路径，让 .zshrc 永远
# 不用改 —— 换变体只是覆盖同一个文件。
omp_write() {
  local variant="$1"
  local src="$THEME_REPO/oh-my-posh/$variant"
  if [ ! -f "$src" ]; then
    warn "缺少 ${src} —— oh-my-posh 未切换"
    return 1
  fi
  mkdir -p "$POSH_DIR"
  cp "$src" "$POSH_ACTIVE"
}

# ── 状态 ─────────────────────────────────────────────────────────────
# 取第一条 `key = value` 的 value，首尾空白去掉。原来是 `cut -d= -f2- | xargs`，但
# xargs 会把内容当命令行解析 —— 路径里出现 ' " 或 \ 就会报 unmatched quote 或被悄悄
# 改写。awk 只做字符串处理，不解释任何东西。
get_key() { # get_key <file> <key>
  awk -v k="$2" '
    $0 ~ "^[ \t]*" k "[ \t]*=" {
      sub("^[ \t]*" k "[ \t]*=[ \t]*", "")
      sub(/[ \t]+$/, "")
      print; exit
    }
  ' "$1" 2>/dev/null
}

show_status() {
  local g w p o
  g=$(get_key "$GHOSTTY_CFG" theme)
  w=$(get_key "$GHOSTTY_CFG" window-theme)
  p=$(awk -F'"' '/"theme"[ \t]*:/ { print $4; exit }' "$PI_SETTINGS" 2>/dev/null)
  if [ -f "$POSH_ACTIVE" ] && [ -f "$THEME_REPO/oh-my-posh/earendil-dark.omp.json" ]; then
    cmp -s "$POSH_ACTIVE" "$THEME_REPO/oh-my-posh/earendil-dark.omp.json" && o=earendil-dark || o=earendil-light
  else
    o='（未配置）'
  fi
  printf '  仓库        %s\n' "$THEME_REPO"
  printf '  Ghostty     theme = %s\n' "${g:-（未设置）}"
  printf '              window-theme = %s\n' "${w:-（未设置）}"
  printf '  pi          %s\n' "${p:-未知}"
  printf '  oh-my-posh  %s  (%s)\n' "$o" "$(tilde "$POSH_ACTIVE")"
}

case "${1:-}" in
  status|"")
    show_status
    ;;
  dark|light)
    mode="$1"
    if [ "$mode" = dark ]; then
      gtheme="$THEME_REPO/ghostty/earendil-dark"; wtheme=dark
      pitheme="earendil-dark";  omp="earendil-dark.omp.json"
    else
      gtheme="$THEME_REPO/ghostty/earendil";      wtheme=light
      pitheme="earendil-light"; omp="earendil-light.omp.json"
    fi
    [ -f "$gtheme" ] || die "找不到终端主题文件 ${gtheme}（THEME_REPO 对了吗？）"

    # 三层都失败时不能还打 ✓，所以先做事、后下结论。
    rc=1
    if ghostty_write "$gtheme" "$wtheme"; then
      rc=0
      if ghostty_reload; then printf '  Ghostty     %s  已热重载\n' "$mode"
      else printf '  Ghostty     %s  新开窗口生效\n' "$mode"; fi
    fi
    pi_write "$pitheme" && { rc=0; printf '  pi          %s\n' "$pitheme"; }
    omp_write "$omp"    && { rc=0; printf '  oh-my-posh  %s\n' "${omp%.omp.json}"; }
    [ "$rc" = 0 ] || die "三层都没能切换"
    printf '\n  当前 pi 会话不会自动重载：/settings → %s\n' "$pitheme"
    ;;
  *)
    sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
