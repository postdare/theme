#!/usr/bin/env bash
# theme — 同步切换 Ghostty / pi / oh-my-posh 三层配色
#
#   theme status    显示三层当前状态
#   theme dark      全部切到暖墨深色
#   theme light     全部切到奶油纸色
#
# 存在的理由：终端底色、pi 主题、oh-my-posh prompt 各自独立保存颜色，手动切必漏
# 其中一层，而漏掉的那层在换底后会直接隐形。实测数据：
#
#   pi 墨色 #241c11 印在暖墨底 #1b1710 上  =  1.06:1   （整个 TUI 消失）
#   prompt 路径 #241c11 印在 #1b1710 上    =  1.06:1
#   prompt 路径 #e8e5de 印在奶油底 #e8e5de 上 = 1.00:1
#
# 每次改动前都会备份到 *.bak-theme。
set -uo pipefail

# ── 定位仓库根：优先 $THEME_REPO，否则由脚本自身位置推导（脚本应在 <repo>/bin/）──
resolve_dir() {
  local p="$1" d
  while [ -L "$p" ]; do
    d="$(cd "$(dirname "$p")" && pwd)"
    p="$(readlink "$p")"
    case "$p" in /*) ;; *) p="$d/$p" ;; esac
  done
  cd "$(dirname "$p")" && pwd
}
SCRIPT_DIR="$(resolve_dir "${BASH_SOURCE[0]:-$0}")"
THEME_REPO="${THEME_REPO:-$(cd "$SCRIPT_DIR/.." && pwd)}"

# ── 各层路径（都可用环境变量覆盖）──
GHOSTTY_CFG="${GHOSTTY_CONFIG:-$HOME/.config/ghostty/config}"
PI_SETTINGS="${PI_SETTINGS:-$HOME/.pi/agent/settings.json}"
POSH_DIR="${POSH_DIR:-$HOME/.poshthemes}"
POSH_ACTIVE="$POSH_DIR/earendil.omp.json"

warn() { printf '  ! %s\n' "$*" >&2; }
die()  { printf '✗ %s\n' "$*" >&2; exit 1; }

# ── Ghostty ──────────────────────────────────────────────────────────
ghostty_write() {
  local theme_path="$1" window_theme="$2"
  [ -f "$GHOSTTY_CFG" ] || { warn "没有 ${GHOSTTY_CFG}，跳过 Ghostty"; return 1; }
  python3 - "$GHOSTTY_CFG" "$theme_path" "$window_theme" <<'PY'
import sys, re, shutil
cfg, theme_path, window_theme = sys.argv[1:4]
shutil.copy2(cfg, cfg + '.bak-theme')
s = open(cfg).read()
def setkey(text, key, value):
    pat = re.compile(rf'^{re.escape(key)}\s*=.*$', re.M)
    line = f'{key} = {value}'
    return pat.sub(line, text, count=1) if pat.search(text) else text.rstrip('\n') + f'\n{line}\n'
s = setkey(s, 'theme', theme_path)
s = setkey(s, 'window-theme', window_theme)
open(cfg, 'w').write(s)
PY
}

ghostty_reload() {
  local pid
  # pgrep 在部分 macOS 环境下看不到 Ghostty 进程，退回 ps
  pid=$(ps -Ao pid,command | grep -F 'MacOS/ghostty' | grep -v grep | awk '{print $1}' | head -1)
  [ -n "$pid" ] && kill -USR2 "$pid" 2>/dev/null
}

# ── pi ───────────────────────────────────────────────────────────────
pi_write() {
  [ -f "$PI_SETTINGS" ] || { warn "没有 ${PI_SETTINGS}，跳过 pi"; return 1; }
  python3 - "$PI_SETTINGS" "$1" <<'PY'
import sys, json, shutil
path, theme = sys.argv[1:3]
shutil.copy2(path, path + '.bak-theme')
d = json.load(open(path))
d['theme'] = theme
open(path, 'w').write(json.dumps(d, indent=2, ensure_ascii=False) + '\n')
PY
}

# ── oh-my-posh ───────────────────────────────────────────────────────
# 注意：本仓库的 oh-my-posh 只提供"提示词"（见 oh-my-posh/README.md），不提供配置
# 文件，所以这两个变体在用户机器上由 AI 生成。缺失时只警告，不阻断另外两层。
omp_write() {
  local variant="$1"
  if [ ! -f "$POSH_DIR/$variant" ]; then
    warn "缺少 $POSH_DIR/$variant —— oh-my-posh 未切换"
    warn "  该文件由 oh-my-posh/README.md 里的提示词生成"
    return 1
  fi
  cp "$POSH_DIR/$variant" "$POSH_ACTIVE"
}

# ── 状态 ─────────────────────────────────────────────────────────────
show_status() {
  local g w p o
  g=$(grep -E '^theme\s*=' "$GHOSTTY_CFG" 2>/dev/null | head -1 | cut -d= -f2- | xargs)
  w=$(grep -E '^window-theme\s*=' "$GHOSTTY_CFG" 2>/dev/null | head -1 | cut -d= -f2- | xargs)
  p=$(python3 -c "import json;print(json.load(open('$PI_SETTINGS'))['theme'])" 2>/dev/null)
  if [ -f "$POSH_ACTIVE" ] && [ -f "$POSH_DIR/earendil-dark.omp.json" ]; then
    cmp -s "$POSH_ACTIVE" "$POSH_DIR/earendil-dark.omp.json" && o=earendil-dark || o=earendil-light
  else
    o='（未配置）'
  fi
  printf '  仓库        %s\n' "$THEME_REPO"
  printf '  Ghostty     theme = %s\n' "${g:-（未设置）}"
  printf '              window-theme = %s\n' "${w:-（未设置）}"
  printf '  pi          %s\n' "${p:-未知}"
  printf '  oh-my-posh  %s\n' "$o"
}

case "${1:-}" in
  status|"")
    show_status
    ;;
  dark|light)
    mode="$1"
    if [ "$mode" = dark ]; then
      gtheme="$THEME_REPO/ghostty/earendil-dark"; wtheme=dark
      pitheme="earendil-dark";  omp="earendil-dark.omp.json"
    else
      gtheme="$THEME_REPO/ghostty/earendil";      wtheme=light
      pitheme="earendil-light"; omp="earendil-light.omp.json"
    fi
    [ -f "$gtheme" ] || die "找不到终端主题文件 ${gtheme}（THEME_REPO 对了吗？）"

    rc=0
    printf '✓ 已切到 %s\n' "$mode"
    if ghostty_write "$gtheme" "$wtheme"; then
      if ghostty_reload; then printf '  Ghostty     已热重载\n'
      else printf '  Ghostty     未能热重载，请按 ⌘⇧,\n'; fi
    fi
    pi_write "$pitheme" && printf '  pi          settings.json → %s\n' "$pitheme"
    omp_write "$omp"    && printf '  oh-my-posh  → %s\n' "$omp"
    printf '\n⚠ 当前 pi 会话不会自动重载：/settings → %s\n' "$pitheme"
    ;;
  *)
    sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
